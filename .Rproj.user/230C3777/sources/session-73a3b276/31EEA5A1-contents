# 2. Clean all source series needed to reproduce the exact estimation sample

```{r}
# Create a cleaned version of the NFC lending-rate dataset
nfc_clean <- nfc %>%
  
  # Keep only the variables needed for my analysis:
  # DATE = observation date
  # cost_of_borrowing_for_corporations = NFC lending rate
  select(DATE, cost_of_borrowing_for_corporations) %>%
  
   rename(
    month = DATE,                 # DATE becomes month
    LoanRate = cost_of_borrowing_for_corporations
  ) %>%
  
  # Clean and transform variables
  # Convert character date format into a proper date object
  # dmy() = day-month-year format
  mutate(
       month = dmy(month),
    
    # By rounding all dates down to the first day of the month I can now create 
    # consistent monthly frequency that can later be merged with ECB policy-rate
    month = floor_date(month, "month"),
    
    # Ensure lending rates are treated as numeric values
    # rather than text/characters
    LoanRate = as.numeric(LoanRate)
  )
```

```{r}
# This section extends ECB data to match the NFC sample period, creates a continuous daily timeline, carries policy rates forward between ECB announcements, and then aggregates these observations into monthly averages.

# Get the latest month available in the NFC dataset
max_nfc_date <- max(nfc_clean$month, na.rm = TRUE)

# Convert ECB policy-rate data to monthly frequency
ecb_monthly <- ecb %>%
  select(DATE, ECB_RATE) %>%
  mutate(
    # Standardize date and rate formats
    DATE = dmy(DATE),
    ECB_RATE = as.numeric(ECB_RATE)
  ) %>%
  arrange(DATE) %>%
  
  # Create a continuous daily timeline
  complete(
    DATE = seq.Date(min(DATE, na.rm = TRUE), max_nfc_date, by = "day")
  ) %>%
  arrange(DATE) %>%
  
  # Carry policy rates forward between ECB changes
  fill(ECB_RATE, .direction = "down") %>%
  
  # Aggregate daily values into monthly averages
  mutate(month = floor_date(DATE, "month")) %>% #Takes each date and rounds it down to the first day of its month
  group_by(month) %>%                           #Group all observations that belong to the same month together
  summarise(
    ECBRate = mean(ECB_RATE, na.rm = TRUE),     #Convert daily ECB observations into a monthly series that can be merged with                                                       monthly NFC lending data.
    .groups = "drop"                            # Removes the grouping structure afterward
  )

```

