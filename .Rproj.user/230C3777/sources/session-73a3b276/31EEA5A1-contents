# 3. Merge data exactly as in the original analysis

```{r}
# Create the main thesis dataset by merging NFC, ECB, HICP, EURIBOR, DFR and deposit-rate data
thesis_data <- nfc_clean %>%
  
  # Standardize NFC data to monthly frequency
  mutate(month = floor_date(month, "month")) %>%
  
  # Merge with monthly ECB policy-rate data
  left_join(ecb_monthly, by = "month") %>%
  
  # Merge with monthly HICP data
  left_join(hicp_clean, by = "month") %>%
  
  # Merge with EURIBOR data
  left_join(EURIBOR_clean, by = "month") %>%
  
  # Merge with DFR data
  left_join(DFR_clean, by = "month") %>%
  
  # Merge with household deposit-rate data
  left_join(deposit_rate_clean, by = "month") %>%
  
  # Sort the dataset chronologically
  arrange(month) %>%
  
  # Fill missing policy-rate values forward
  # and calculate inflation/HICP change
  mutate(
    ECBRate = na.locf(ECBRate, na.rm = FALSE),
    DFR     = na.locf(DFR, na.rm = FALSE),
    
    # Month-over-month HICP change
    Inflation = 100 * (log(HICP) - log(lag(HICP, 1))),
    
    # YoY HICP change for descriptive statistics in figure 1 only
    Inflation_YoY = 100 * (log(HICP) - log(lag(HICP,12)))
  )

```

