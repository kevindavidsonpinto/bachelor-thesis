# 5. Construct the regression dataset exactly as in the original analysis

```{r}
thesis_model <- thesis_data %>%
  arrange(month) %>%
  mutate(
    # Monthly change in NFC lending rate
    d_LoanRate = LoanRate - lag(LoanRate),
    
    # Monthly change in ECB policy rate
    d_ECBRate = ECBRate - lag(ECBRate),
    
    #Monthly change in deposit facility rate
    d_DFR = DFR - lag(DFR), 
    
    #Monthly change in Euribor
    d_EURIBOR = EURIBOR - lag(EURIBOR),
    
    #Monthly change in deposit rate
    d_DepositRate = DepositRate - lag(DepositRate),

    # Post-2022 dummy
    Post2022 = if_else(month >= as.Date("2022-07-01"), 1, 0),
        
    d_DepositRate_Post2022 = d_DepositRate * Post2022
  ) %>%
  
  # Create ECB-rate-change lags from t-1 to t-12
  mutate(
    across(
      .cols = d_ECBRate,
      .fns = list(
        lag1  = ~ lag(.x, 1),
        lag2  = ~ lag(.x, 2),
        lag3  = ~ lag(.x, 3),
        lag4  = ~ lag(.x, 4),
        lag5  = ~ lag(.x, 5),
        lag6  = ~ lag(.x, 6),
        lag7  = ~ lag(.x, 7),
        lag8  = ~ lag(.x, 8),
        lag9  = ~ lag(.x, 9),
        lag10 = ~ lag(.x, 10),
        lag11 = ~ lag(.x, 11),
        lag12 = ~ lag(.x, 12)
      ),
      .names = "{.col}_{.fn}"
    )
  ) %>%
  
# Create DFR-rate-change lags from t-1 to t-12
  mutate(
    across(
      .cols = d_DFR,
      .fns = list(
        lag1  = ~ lag(.x, 1),
        lag2  = ~ lag(.x, 2),
        lag3  = ~ lag(.x, 3),
        lag4  = ~ lag(.x, 4),
        lag5  = ~ lag(.x, 5),
        lag6  = ~ lag(.x, 6),
        lag7  = ~ lag(.x, 7),
        lag8  = ~ lag(.x, 8),
        lag9  = ~ lag(.x, 9),
        lag10 = ~ lag(.x, 10),
        lag11 = ~ lag(.x, 11),
        lag12 = ~ lag(.x, 12)
      ),
      .names = "{.col}_{.fn}"
    )
  ) %>%
  
  # Create interaction terms for t, t-1, ..., t-12
  mutate(
    d_ECBRate_Post2022 = d_ECBRate * Post2022,
    across(
      .cols = starts_with("d_ECBRate_lag"),
      .fns = ~ .x * Post2022,
      .names = "{.col}_Post2022"
    )
  ) %>%
  
  # Drop missing rows caused by differencing and 12 lags
  drop_na()

```

