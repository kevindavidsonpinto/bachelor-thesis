#Model 1: BASELINE MODEL PASS-THROUGH
# Estimate the baseline pass-through regression model with lags up to t-12
model_baseline <- lm(
  d_LoanRate ~ 
    d_ECBRate +
    d_ECBRate_lag1 +
    d_ECBRate_lag2 +
    d_ECBRate_lag3 +
    d_ECBRate_lag4 +
    d_ECBRate_lag5 +
    d_ECBRate_lag6 +
    d_ECBRate_lag7 +
    d_ECBRate_lag8 +
    d_ECBRate_lag9 +
    d_ECBRate_lag10 +
    d_ECBRate_lag11 +
    d_ECBRate_lag12,
  data = thesis_model
)

# GITHUB CLEANUP [OPTIONAL]: Console model output may be retained for transparency or suppressed in the rendered notebook.
# Do not alter the model object or Newey-West covariance settings.
# Display regression results with Newey-West standard errors
# Newey-West corrects for heteroskedasticity and autocorrelation, not multicollinearity
coeftest(
  model_baseline,
  vcov. = NeweyWest(model_baseline, lag = 12, prewhite = FALSE)
)

# Create formatted regression table
