here()
list.files(data_dir)
all(file.exists(
file.path(
data_dir,
c(
"ECB_Data_Portal_20260421221734_clean.csv",
"NFC_31012003_31032026_clean.csv",
"EURIBOR 31011994_30042026_clean.csv",
"prc_hicp_clean.csv",
"HH_Dep_Rate_01012003_31032026_clean.csv",
"ECB DFR_01011999_17062026_clean.csv"
)
)
))
# Create a line graph comparing NFC lending rate, ECB policy rate, DFR, and inflation
fig0 <- thesis_data %>%
filter(!is.na(LoanRate), !is.na(ECBRate), !is.na(DFR), !is.na(Inflation)) %>%
ggplot(aes(x = month)) +
geom_line(
aes(y = LoanRate, color = "NFC Lending Rate"),
linewidth = 0.5
) +
geom_line(
aes(y = ECBRate, color = "ECB Policy Rate"),
linewidth = 0.5
) +
geom_line(
aes(y = DFR, color = "Deposit Facility Rate"),
linewidth = 0.5
) +
geom_line(
aes(y = Inflation_YoY, color = "HICP Inflation"),
linewidth = 0.5
) +
labs(
title = "ECB Policy Rates, Euro-Area NFC Lending Rate, and Inflation",
x = "Year",
y = "Percent (%)",
color = "",
caption = paste0(
"**Figure 0:** ECB policy rates, euro-area NFC lending rate, and HICP inflation.<br><br>",
"*Note:* The figure plots monthly euro-area data.<br>",
"The NFC lending rate captures the cost of borrowing for non-financial corporations.<br>",
"The ECB policy rate refers to the Main Refinancing Operations (MRO) rate.<br>",
"The Deposit Facility Rate (DFR) captures the interest rate paid on excess reserves.<br>",
"Inflation is measured as the annual HICP inflation rate.<br><br>",
"**Source:** European Central Bank (ECB) Data Portal."
)
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
legend.position = "bottom",
plot.caption = ggtext::element_textbox_simple(
size = 9,
hjust = 0,
width = unit(1, "npc"),
margin = margin(t = 10)
),
plot.margin = margin(t = 10, r = 10, b = 35, l = 10)
)
fig0
# Save Figure 0 to the repository's outputs/figures folder
ggsave(
filename = file.path(
figure_dir,
"figure0_ecb_nfc_dfr_inflation.png"
),
plot = fig0,
width = 8,
height = 5,
dpi = 300,
bg = "white"
)
