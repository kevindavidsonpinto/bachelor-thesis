library(ggplot2)
library(sandwich)
library(lmtest)
library(modelsummary)
library(lubridate)
library(tidyverse)
library(zoo)
library(flextable)
library(officer)
library(webshot2)
library(car)
#options(modelsummary_factory = "kableExtra")
#options(modelsummary_format_numeric_latex = "plain")
#tinytex::reinstall_tinytex()
# Use the repository root as the project base.
# Open the project through bachelor-thesis.Rproj before running this script.
library(here)
data_dir <- here("data", "clean")
ecb <- read_csv(
file.path(data_dir, "ECB_Data_Portal_20260421221734_clean.csv")
)
nfc <- read_csv(
file.path(data_dir, "NFC_31012003_31032026_clean.csv")
)
euribor <- read.csv(
file.path(data_dir, "EURIBOR 31011994_30042026_clean.csv")
)
hcip <- read.csv(
file.path(data_dir, "prc_hicp_clean.csv")
)
hh_deposit <- read.csv(
file.path(data_dir, "HH_Dep_Rate_01012003_31032026_clean.csv")
)
dfr <- read.csv(
file.path(data_dir, "ECB DFR_01011999_17062026_clean.csv")
)
# Create a cleaned version of the NFC lending-rate dataset
nfc_clean <- nfc %>%
# Keep only the variables needed for my analysis:
# DATE = observation date
# cost_of_borrowing_for_corporations = NFC lending rate
select(DATE, cost_of_borrowing_for_corporations) %>%
rename(
month = DATE,                 # DATE becomes month
LoanRate = cost_of_borrowing_for_corporations
) %>%
# Clean and transform variables
# Convert character date format into a proper date object
# dmy() = day-month-year format
mutate(
month = dmy(month),
# By rounding all dates down to the first day of the month I can now create
# consistent monthly frequency that can later be merged with ECB policy-rate
month = floor_date(month, "month"),
# Ensure lending rates are treated as numeric values
# rather than text/characters
LoanRate = as.numeric(LoanRate)
)
# This section extends ECB data to match the NFC sample period, creates a continuous daily timeline, carries policy rates forward between ECB announcements, and then aggregates these observations into monthly averages.
# Get the latest month available in the NFC dataset
max_nfc_date <- max(nfc_clean$month, na.rm = TRUE)
# Convert ECB policy-rate data to monthly frequency
ecb_monthly <- ecb %>%
select(DATE, ECB_RATE) %>%
mutate(
# Standardize date and rate formats
DATE = dmy(DATE),
ECB_RATE = as.numeric(ECB_RATE)
) %>%
arrange(DATE) %>%
# Create a continuous daily timeline
complete(
DATE = seq.Date(min(DATE, na.rm = TRUE), max_nfc_date, by = "day")
) %>%
arrange(DATE) %>%
# Carry policy rates forward between ECB changes
fill(ECB_RATE, .direction = "down") %>%
# Aggregate daily values into monthly averages
mutate(month = floor_date(DATE, "month")) %>% #Takes each date and rounds it down to the first day of its month
group_by(month) %>%                           #Group all observations that belong to the same month together
summarise(
ECBRate = mean(ECB_RATE, na.rm = TRUE),     #Convert daily ECB observations into a monthly series that can be merged with                                                       monthly NFC lending data.
.groups = "drop"                            # Removes the grouping structure afterward
)
#create a clean version of the HICP dataset
hicp_clean <- hcip  %>%
# Keep only the variables needed for my analysis:
# DATE = observation date
# cost_of_borrowing_for_corporations = NFC lending rate
select(DATE, OBS_VALUE) %>%
rename(
month = DATE,                 # DATE becomes month
HICP = OBS_VALUE
) %>%
# Clean and transform variables
# Convert character date format into a proper date object
# dmy() = day-month-year format
mutate(
month = dmy(month),
# By rounding all dates down to the first day of the month I can now create
# consistent monthly frequency that can later be merged with ECB policy-rate
month = floor_date(month, "month"),
# Ensure lending rates are treated as numeric values
# rather than text/characters
HICP = as.numeric(HICP)
)
#create a clean version of the EURIBOR dataset
EURIBOR_clean <- euribor  %>%
# Keep only the variables needed for my analysis:
# DATE = observation date
# cost_of_borrowing_for_corporations = NFC lending rate
select(DATE, EURIBOR_3MO) %>%
rename(
month = DATE,                 # DATE becomes month
EURIBOR = EURIBOR_3MO
) %>%
# Clean and transform variables
# Convert character date format into a proper date object
# dmy() = day-month-year format
mutate(
month = dmy(month),
# By rounding all dates down to the first day of the month I can now create
# consistent monthly frequency that can later be merged with ECB policy-rate
month = floor_date(month, "month"),
# Ensure lending rates are treated as numeric values
# rather than text/characters
EURIBOR = as.numeric(EURIBOR)
)
# Create a clean version of the household deposit-rate dataset
deposit_rate_clean <- hh_deposit %>%
# Keep only the variables needed for the analysis
select(DATE, overnight_deposits_from_households) %>%
# Rename variables
rename(
month = DATE,
DepositRate = overnight_deposits_from_households
) %>%
# Clean and transform variables
mutate(
# Convert dates for monthly time-series analysis
month = dmy(month),
# Standardize observations to monthly frequency
month = floor_date(month, "month"),
# Ensure deposit rates are numeric
DepositRate = as.numeric(DepositRate)
)
# Create a cleaned-up version of the Deposit Facility Rate Dataset
#keep only MONTH and DFR
# Create clean version of DFR dataset
DFR_clean <- dfr %>%
select(MONTH, DEPOSIT_FACILITY_RATE) %>%
rename(
month = MONTH,
DFR = DEPOSIT_FACILITY_RATE
) %>%
mutate(
month = dmy(month),
month = floor_date(month, "month"),
DFR = as.numeric(DFR)
) %>%
group_by(month) %>%
summarise(
DFR = last(DFR),
.groups = "drop"
)
# Create the main thesis dataset by merging NFC, ECB, HICP, EURIBOR, DFR and deposit-rate data
thesis_data <- nfc_clean %>%
# Standardize NFC data to monthly frequency
mutate(month = floor_date(month, "month")) %>%
# Merge with monthly ECB policy-rate data
left_join(ecb_monthly, by = "month") %>%
# Merge with monthly HICP data
left_join(hicp_clean, by = "month") %>%
# Merge with EURIBOR data
left_join(EURIBOR_clean, by = "month") %>%
# Merge with DFR data
left_join(DFR_clean, by = "month") %>%
# Merge with household deposit-rate data
left_join(deposit_rate_clean, by = "month") %>%
# Sort the dataset chronologically
arrange(month) %>%
# Fill missing policy-rate values forward
# and calculate inflation/HICP change
mutate(
ECBRate = na.locf(ECBRate, na.rm = FALSE),
DFR     = na.locf(DFR, na.rm = FALSE),
# Month-over-month HICP change
Inflation = 100 * (log(HICP) - log(lag(HICP, 1))),
# YoY HICP change for descriptive statistics in figure 1 only
Inflation_YoY = 100 * (log(HICP) - log(lag(HICP,12)))
)
knitr::opts_chunk$set(echo = TRUE)
# Load packages
